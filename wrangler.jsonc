{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinema-party",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinema-party",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BOT_USERNAME": "",
    "APP_SHORT_NAME": ""
  }
}
