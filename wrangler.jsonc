{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cinema-party",
	"main": "src/worker.js",
	"compatibility_date": "2025-09-01",
	"triggers": {
		"crons": ["0 3 * * *"]
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/telegram"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cinema-party",
			"database_id": "ff34ad4d-13c1-46c7-8702-d8053c299344",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"BOT_USERNAME": "cine_party_bot",
		"APP_SHORT_NAME": "cinema"
	}
}