{
  "name": "cinema-party",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var DEV_AUTH:1",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "setup": "node scripts/setup.mjs",
    "deploy": "wrangler deploy",
    "webhook": "node scripts/set-webhook.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "node --test test/auth.test.mjs",
    "test:api": "node --test test/api.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  }
}
